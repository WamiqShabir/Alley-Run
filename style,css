* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #1a120b;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  color: #f5e6c8;
}

#game-container {
  position: relative;
  width: 900px;
  height: 500px;
  box-shadow: 0 0 40px rgba(180, 40, 20, 0.4), 0 0 80px rgba(0, 0, 0, 0.6);
  border: 3px solid #8b4513;
  border-radius: 8px;
  overflow: hidden;
  background: #2a1f14;
}

#gameCanvas {
  display: block;
  background: #3d2b1f;
}

.screen {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: rgba(20, 12, 6, 0.92);
  z-index: 10;
  text-align: center;
  padding: 20px;
}

.hidden, #hud.hidden {
  display: none;
}

h1 {
  font-size: 4.5rem;
  font-weight: 900;
  letter-spacing: 6px;
  color: #e8c547;
  text-shadow: 0 0 20px rgba(232, 197, 71, 0.5), 3px 3px 0 #8b1a1a;
  margin-bottom: 8px;
}

h2 {
  font-size: 3.2rem;
  color: #e8c547;
  text-shadow: 2px 2px 0 #8b1a1a;
  margin-bottom: 12px;
}

.subtitle {
  font-size: 1.15rem;
  color: #d4a574;
  margin-bottom: 28px;
  max-width: 480px;
}

.instructions {
  background: rgba(139, 69, 19, 0.35);
  border: 1px solid #8b4513;
  border-radius: 10px;
  padding: 16px 28px;
  margin-bottom: 28px;
  line-height: 1.7;
  font-size: 0.95rem;
}

.instructions strong {
  color: #e8c547;
  display: block;
  margin-bottom: 6px;
  font-size: 1.05rem;
}

.btn {
  background: linear-gradient(180deg, #c0392b, #8b1a1a);
  color: #fff;
  border: none;
  padding: 14px 42px;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 2px;
  border-radius: 6px;
  cursor: pointer;
  box-shadow: 0 4px 0 #5c1010, 0 6px 15px rgba(0,0,0,0.4);
  transition: transform 0.1s, box-shadow 0.1s;
  margin: 6px;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 0 #5c1010, 0 8px 20px rgba(0,0,0,0.45);
}

.btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #5c1010;
}

.btn-secondary {
  background: linear-gradient(180deg, #6b5344, #4a3728);
  box-shadow: 0 4px 0 #2e2218, 0 6px 15px rgba(0,0,0,0.4);
}

.btn-secondary:hover {
  box-shadow: 0 6px 0 #2e2218, 0 8px 20px rgba(0,0,0,0.45);
}

.credit {
  margin-top: 30px;
  font-size: 0.8rem;
  color: #8a7a6a;
}

#hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px;
  background: linear-gradient(180deg, rgba(0,0,0,0.65), transparent);
  z-index: 5;
  font-weight: 700;
  font-size: 1.1rem;
  pointer-events: none;
}

#level-display {
  color: #e8c547;
}

#distance-display {
  color: #f5e6c8;
  font-variant-numeric: tabular-nums;
}

#lives-display {
  color: #e74c3c;
  letter-spacing: 4px;
}

/* Responsive */
@media (max-width: 940px) {
  #game-container {
    width: 100vw;
    height: 56.25vw;
    max-height: 100vh;
    border-radius: 0;
    border: none;
  }
  #gameCanvas {
    width: 100%;
    height: 100%;
  }
  h1 { font-size: 2.8rem; letter-spacing: 3px; }
  h2 { font-size: 2.2rem; }
}

#hud.hidden {
  display: none !important;
}
